{"key": "2cd4de0faee1d475e334cc1d838551562bc9fe596b78afee6cffc68fb6302b55", "run_id": "handwritten", "model_name": "handwritten", "model": "handwritten", "settings": {}, "task": "summary", "variant": "handwritten", "rep": 0, "scenario_id": "recovery_003", "set": "calibration", "condition": "recovery", "kind": "attribution", "content_hash": "a57b6df8d8f4c40be2c76b28fe6160fd7de3657965dba86946ad65fa83ab6a8d", "disturbance_position": "history", "text": "Adele hatte einen ruhigen Samstagvormittag und entschied, dass Andrea sie zur Augenoperation fährt, weil diese zuerst gefragt hatte. Gegen Ende wirkte sie kurz verwirrt, stellte dann aber klar, dass das Radio lief und es ihr gut geht.", "chars": 234, "stop_reason": "end_turn", "usage": {}, "cost_usd": 0.0, "latency": null, "from_cache": true, "handwritten_id": "h30"}
