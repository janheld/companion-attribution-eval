{"key": "f4b2ec01db589140ae4eb769022ee9056469b090d9f161f9136efd87e7d916b6", "run_id": "handwritten", "model_name": "handwritten", "model": "handwritten", "settings": {}, "task": "response", "variant": "handwritten", "rep": 0, "scenario_id": "tv_bleed_001", "set": "calibration", "condition": "tv_bleed", "kind": "attribution", "content_hash": "bc022edbe2f04dc96e85a99fc12dbf4ed711909152f45ce6c28b6da6fe05ffc6", "disturbance_position": "final_turn", "text": "Ein Brand? Wo war denn das, Gottlieb? Hoffentlich ist da niemand was passiert.", "chars": 78, "stop_reason": "end_turn", "usage": {}, "cost_usd": 0.0, "latency": null, "from_cache": true, "handwritten_id": "h28"}
